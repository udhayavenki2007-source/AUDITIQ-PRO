generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORD
  DEPT_HEAD
  AUDITOR
}

enum AuditStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
}

enum ReviewStatus {
  COMPLIANT
  PARTIAL
  NON_COMPLIANT
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role
  departmentId String?
  department Department? @relation(fields: [departmentId], references: [id])
  reviews Review[]
  createdAt DateTime @default(now())
}
model Department {
  id String @id @default(cuid())
  name String
  code String @unique
  users User[]
  submissions Submission[]
  actionItems ActionItem[]
  createdAt DateTime @default(now())
}
model AuditCycle {
  id String @id @default(cuid())
  title String
  year Int
  status AuditStatus @default(DRAFT)
  checklistItems ChecklistItem[]
  createdAt DateTime @default(now())
  @@unique([year, title])
}
model ChecklistItem {
  id String @id @default(cuid())
  auditCycleId String
  auditCycle AuditCycle @relation(fields: [auditCycleId], references: [id], onDelete: Cascade)
  category String
  title String
  description String
  weightagePercentage Float
  submissions Submission[]
  @@index([auditCycleId])
}
model Submission {
  id String @id @default(cuid())
  checklistItemId String
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  evidenceUrl String?
  fileType String?
  status SubmissionStatus @default(PENDING)
  review Review?
  submittedAt DateTime?
  @@unique([checklistItemId, departmentId])
}
model Review {
  id String @id @default(cuid())
  submissionId String @unique
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  auditorId String
  auditor User @relation(fields: [auditorId], references: [id])
  status ReviewStatus
  score Float
  remarks String?
  actionItems ActionItem[]
  reviewedAt DateTime @default(now())
}
model ActionItem {
  id String @id @default(cuid())
  reviewId String
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  departmentId String
  department Department @relation(fields: [departmentId], references: [id])
  title String
  deadline DateTime
  status ActionStatus @default(OPEN)
  createdAt DateTime @default(now())
  @@index([departmentId, status])
}
